# Python bytecode and pytest caches
__pycache__/
*.pyc
.pytest_cache/
*cache*
# ...but never let *cache* swallow source-controlled files (migrations,
# code) that legitimately mention "cache" — they are not cache artifacts.
!*.sql
!*.py
!*.php
!*.jsx
!*.ts
!*.tsx
